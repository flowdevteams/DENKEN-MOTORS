generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ENUMS
enum Role {
  USER
  ADMIN
  OWNER
}

enum CarTransmission {
  Automatic
  Manual
}

enum CarFuel {
  Bensin
  Diesel
  Listrik
  Hybrid
}

enum CarCondition {
  Baru
  Bekas
}

enum CarType {
  SUV
  MPV
  Sedan
  Hatchback
  Pickup
  Luxury
}

enum LeadType {
  Kredit
  Cash
  Trade_In @map("Trade-In")
  Kontak
}

enum LeadStatus {
  Baru
  FollowUp
  TestDrive
  Negosiasi
  Diproses
  SPK
  Disetujui
  Selesai
  Ditolak
  Batal
}

// MODELS
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  
  cars      Car[]    @relation("OwnerCars")
  leads     Lead[]   @relation("OwnerLeads")
  branches  Branch[] @relation("OwnerBranches")
  expenses  Expense[] @relation("OwnerExpenses")
  transactions Transaction[] @relation("OwnerTransactions")
}

model Branch {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  city        String
  address     String
  mapUrl      String?
  phone       String?
  openDays    String?  // e.g. "Senin - Sabtu"
  openHours   String?  // e.g. "09:00 - 18:00"
  description String?
  isActive    Boolean  @default(true)
  
  ownerId     String
  owner       User     @relation("OwnerBranches", fields: [ownerId], references: [id], onDelete: Cascade)
  
  cars        Car[]    @relation("BranchCars")
  expenses    Expense[] @relation("BranchExpenses")
  transactions Transaction[] @relation("BranchTransactions")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Car {
  id                  String          @id @default(cuid())
  slug                String          @unique
  brand               String
  name                String
  year                Int
  price               Float           // Harga Cash OTR
  priceCredit         Float?          // Harga Paket Kredit (Strategi Showroom Lokal)
  monthly             Float
  dp                  Float
  transmission        CarTransmission
  fuel                CarFuel
  engine              String
  mileage             Int
  color               String
  type                CarType
  condition           CarCondition
  location            String
  image               String
  gallery             String[]
  badge               String?
  isSoldOut           Boolean         @default(false)
  description         String
  features            String[]
  
  // Spesifikasi Vital Showroom Indonesia
  taxDate             String?         // Masa Pajak STNK (e.g. "Oktober 2026")
  plateNumber         String?         // Nopol & Ganjil/Genap (e.g. "B 1234 XYZ (Genap)")
  ownership           String?         @default("Tangan Pertama (Pribadi)")
  serviceRecord       String?         @default("Bengkel Resmi (ATPM)")
  documents           String[]        @default([]) // BPKB, STNK, Faktur, Kunci Serep, Buku Manual
  isFloodFree         Boolean         @default(true)
  isAccidentFree      Boolean         @default(true)
  isOdometerVerified  Boolean         @default(true)
  warrantyDays        Int             @default(365)
  
  ownerId             String
  owner               User            @relation("OwnerCars", fields: [ownerId], references: [id], onDelete: Cascade)
  
  branchId            String?
  branch              Branch?         @relation("BranchCars", fields: [branchId], references: [id], onDelete: SetNull)
  
  leads               Lead[]          @relation("CarLeads")
  expenses            Expense[]       @relation("CarExpenses")
  transactions        Transaction[]   @relation("CarTransactions")

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Lead {
  id        String     @id @default(cuid())
  type      LeadType
  name      String
  whatsapp  String
  email     String?
  city      String?
  
  carId     String?
  car       Car?       @relation("CarLeads", fields: [carId], references: [id], onDelete: SetNull)
  carName   String?
  
  details   Json?
  
  status    LeadStatus @default(Baru)
  assignedTo String?
  notes     String?
  
  ownerId   String?
  owner     User?      @relation("OwnerLeads", fields: [ownerId], references: [id], onDelete: SetNull)
  
  transactions Transaction[] @relation("LeadTransactions")

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Kategori Pengeluaran Operasional Showroom
enum ExpenseCategory {
  Operasional   // Listrik, air, sewa gedung
  Servis        // Service/perbaikan unit
  Poles         // Poles, detailing, coating
  Dokumen       // Biaya balik nama, mutasi, pajak
  Marketing     // Iklan, promosi, event
  Gaji          // Gaji sales, admin
  Lainnya
}

// Tipe Transaksi Penjualan
enum TransactionType {
  Penjualan
  TradeIn
}

enum PaymentMethod {
  Cash
  Kredit
  TradeIn
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Float
  date        DateTime        @default(now())
  
  carId       String?
  car         Car?            @relation("CarExpenses", fields: [carId], references: [id], onDelete: SetNull)
  
  branchId    String?
  branch      Branch?         @relation("BranchExpenses", fields: [branchId], references: [id], onDelete: SetNull)
  
  ownerId     String
  owner       User            @relation("OwnerExpenses", fields: [ownerId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Transaction {
  id            String          @id @default(cuid())
  type          TransactionType @default(Penjualan)
  
  carId         String?
  car           Car?            @relation("CarTransactions", fields: [carId], references: [id], onDelete: SetNull)
  carName       String          // Snapshot nama mobil saat dijual
  
  leadId        String?
  lead          Lead?           @relation("LeadTransactions", fields: [leadId], references: [id], onDelete: SetNull)
  
  buyerName     String
  buyerPhone    String?
  salePrice     Float           // Harga jual final
  paymentMethod PaymentMethod   @default(Cash)
  
  branchId      String?
  branch        Branch?         @relation("BranchTransactions", fields: [branchId], references: [id], onDelete: SetNull)
  
  ownerId       String
  owner         User            @relation("OwnerTransactions", fields: [ownerId], references: [id], onDelete: Cascade)
  
  soldAt        DateTime        @default(now())
  notes         String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  car       String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
